    "export-indicadores": "node --env-file-if-exists=../.env --import tsx ./src/export-indicadores.ts",
    "import-indicadores": "node --env-file-if-exists=../.env --import tsx ./src/import-indicadores.ts",
    "import-databricks": "node --env-file-if-exists=../.env --import tsx ./src/import-databricks.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
