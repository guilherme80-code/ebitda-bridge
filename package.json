{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "10.33.4"
  },
  "scripts": {
    "preinstall": "node ./scripts/check-package-manager.mjs",
    "dev": "pnpm --parallel --filter @workspace/api-server --filter @workspace/bridge-ebitda run dev",
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "dev:web": "pnpm --filter @workspace/bridge-ebitda run dev",
    "test": "node ./scripts/test.mjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": ">=3.1.5",
      "brace-expansion@>=5.0.0 <5.0.9": ">=5.0.9",
      "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
    }
  }
}
