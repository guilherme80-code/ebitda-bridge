# Copie para .env na raiz. Este arquivo nao contem credenciais reais.
# Backend e scripts: Node 24 carrega .env antes de importar a aplicacao.
# Variaveis ja definidas no terminal/ambiente tem precedencia.

# Portas locais independentes (nao defina PORT globalmente ao usar pnpm dev).
API_PORT=3000
FRONTEND_PORT=5173
BASE_PATH=/
LOG_LEVEL=info
# NODE_ENV e definido pelo comando dev da API; nao e necessario aqui.
# PORT e um override por processo, preservado para o Replit.

# Preencher somente depois de preparar uma base local e revisar o seed.
# Formato: postgresql://<usuario>:<senha>@localhost:5432/<banco>
DATABASE_URL=

# Anthropic: a API atual exige AMBAS no startup, mesmo sem usar o simulador.
# Build, typecheck e pnpm test nao precisam dessas variaveis.
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=
AI_INTEGRATIONS_ANTHROPIC_API_KEY=

# OpenAI: opcional; nao utilizado pelas rotas atuais.
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_OPENAI_API_KEY=

# Databricks: opcional para o painel; importador ainda depende do Replit.
# Nao configure tokens artificiais: a autenticacao sera migrada depois.
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_INDICADORES_TABLE=
DATABRICKS_ITENS_TABLE=
# Variaveis provisionadas pelo Replit, sem equivalentes locais nesta etapa:
# REPLIT_CONNECTORS_HOSTNAME, REPL_IDENTITY, WEB_REPL_RENEWAL, REPL_ID

# pnpm test forca 0 independentemente do ambiente e nao carrega este arquivo.
# Nunca habilite os testes destrutivos contra dados reais.
RUN_DB_INT_TESTS=0
